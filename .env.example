# Copie ce fichier en .env (jamais commité, voir .gitignore) et remplis les vraies valeurs.
# Spring Boot charge .env automatiquement (spring.config.import dans application.yaml),
# à condition de lancer l'application depuis le dossier qui contient ce fichier.
# Si tu lances depuis un IDE, tu peux aussi définir ces variables dans sa configuration de lancement.

DB_PASSWORD=ton_mot_de_passe_postgres
# Génère un secret avec : openssl rand -base64 48
JWT_SECRET=un_secret_long_et_aleatoire

# --- Twilio (SMS) ---
# Console Twilio : https://console.twilio.com
# Account SID : visible en haut à gauche de la console (commence par "AC").
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth Token : menu de gauche -> "API Keys & Tokens" -> Auth Token -> "Show".
# ATTENTION : il ne s'affiche qu'UNE SEULE FOIS. Copie-le ici tout de suite.
TWILIO_AUTH_TOKEN=ton_auth_token_twilio
# Ton numéro Twilio, au format international E.164 : +221771234567.
# Console Twilio -> "Phone Numbers" : c'est ce numéro qui envoie les SMS.
TWILIO_FROM=+221771234567
# Mets true pour activer l'envoi réel par Twilio (sinon les SMS finissent
# dans les logs). ATTENTION : un compte trial refuse les messages libres
# ("trial accounts have limited parameter access") : il faut un compte
# upgradé pour que les SMS partent vraiment.
TWILIO_ENABLED=false
